<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 网络 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 定位（主控端地图获取本机位置；受控端 GPS 用系统 LocationManager，与此无关） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 后台保活 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 录音（语音对讲） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 相机（扫码连接） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 13+ 通知权限（围栏告警） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 存储（腾讯地图瓦片缓存，Android 10+ 用分区存储） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".InkControllerApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.InkLink">

        <!-- 腾讯地图 SDK Key -->
        <meta-data
            android:name="TencentMapSDK"
            android:value="${TENCENT_MAP_KEY}" />

        <activity
            android:name=".ui.ControllerActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MapActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.FenceEditActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.DeviceManageActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.DeviceDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.PetDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.ChatActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- 轨迹 GPX 导出文件分享 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
