<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvPinyinProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="拼音森林 · 0/6"
        android:textColor="#FFD54F"
        android:textSize="16sp" />

    <!-- 字母卡 -->
    <LinearLayout
        android:id="@+id/pinyinIntroCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#1E1E1E"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvPinyinLetter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="b"
            android:textColor="#4FC3F7"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPinyinTips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="双唇紧闭,气流冲开"
            android:textColor="#BDBDBD"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvPinyinProxy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="像读:波"
            android:textColor="#A5D6A7"
            android:textSize="17sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPinyinSpeak"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="🔊 读一读" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPinyinLearned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#43A047"
            android:paddingStart="34dp"
            android:paddingEnd="34dp"
            android:text="我学会了!"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- 配对题 -->
    <LinearLayout
        android:id="@+id/pinyinQuizCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#1E1E1E"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPinyinQuizChar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="妈"
            android:textColor="#FFFFFF"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPinyinQuizEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="👩"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="它的拼音是哪个?"
            android:textColor="#9E9E9E"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPOpt1"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:textSize="22sp"
            android:textColor="#212121" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPOpt2"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:textSize="22sp"
            android:textColor="#212121" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPOpt3"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:textSize="22sp"
            android:textColor="#212121" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPOpt4"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:textSize="22sp"
            android:textColor="#212121" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvPinyinError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="#FF8A80"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
