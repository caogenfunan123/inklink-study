<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvHanziProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="识字屋 · 0/5"
        android:textColor="#FFD54F"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvHanziChar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="一"
        android:textColor="#FFD54F"
        android:textSize="88sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHanziPinyin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="yī"
        android:textColor="#4FC3F7"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tvHanziPhrase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="词语:一天"
        android:textColor="#A5D6A7"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvHanziSentence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="一天一个苹果"
        android:textColor="#BDBDBD"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHanziSpeak"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="🔊 读一读" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHOpt1"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:textSize="26sp"
            android:textColor="#212121" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHOpt2"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:textSize="26sp"
            android:textColor="#212121" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHOpt3"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:textSize="26sp"
            android:textColor="#212121" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHOpt4"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_margin="6dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            android:textSize="26sp"
            android:textColor="#212121" />
    </LinearLayout>

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvHanziError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="#FF8A80"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
